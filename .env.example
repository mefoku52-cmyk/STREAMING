NODE_ENV=development
APP_NAME=cmep-streaming
SIGNALING_HOST=127.0.0.1
SIGNALING_PORT=8504
WEB_HOST=127.0.0.1
WEB_PORT=8502
PUBLIC_ORIGIN=http://127.0.0.1:8502
LOG_LEVEL=info
# HMAC secret for local dev session tokens (mint with scripts/mint-token.sh).
# In production min 32 chars, unique per environment, stored outside git.
SESSION_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
# mediasoup RTC port range — 60000+ chosen to avoid overlap with the
# live-prototype worker (10000-59999) when both run on the same device.
RTC_MIN_PORT=60000
RTC_MAX_PORT=60100
# Announced IP for LAN/remote WebRTC (leave empty for loopback-only testing)
ANNOUNCED_IP=
# Optional FFmpeg recording pipeline (off by default).
# Two port sets per stream: mediasoup plain transports (Ms) and FFmpeg (Ff).
ENABLE_RECORDER=0
FFMPEG_PATH=ffmpeg
RTMP_URL=
REC_VIDEO_MS_PORT=7120
REC_VIDEO_MS_RTCP_PORT=7121
REC_VIDEO_FF_PORT=7130
REC_VIDEO_FF_RTCP_PORT=7131
REC_AUDIO_MS_PORT=7122
REC_AUDIO_MS_RTCP_PORT=7123
REC_AUDIO_FF_PORT=7132
REC_AUDIO_FF_RTCP_PORT=7133
# CMEP adapter: local (dev, deny-by-default rules) | http (waste-platform integration)
CMEP_ADAPTER=local
# http mode requires (fail-closed without them):
#   base URL of the CMEP platform (waste-platform FastAPI)
CMEP_PLATFORM_URL=http://127.0.0.1:8001
#   internal platform<->streaming key (X-CMEP-Internal-Key), min 32 chars, same value
#   as CMEP_INTERNAL_API_KEY on the platform
CMEP_INTERNAL_API_KEY=
#   disable platform verify (LOCAL DEV ONLY — default is verify-on, fail-closed)
CMEP_HTTP_VERIFY=1
#   platform HTTP timeout (ms)
CMEP_HTTP_TIMEOUT_MS=4000
