# CMEP Streaming — produkčné environment premenné
# Skopírujte do /opt/cmep-streaming/.env a nahraďte každú "VÁŠ_..." hodnotu.
# Tento súbor nikdy neukladajte do Gitu (je v .gitignore).

# --- Node.js ---
NODE_ENV=production
APP_NAME=cmep-streaming

# --- Signaling / HTTP + WebSocket (port 443 cez Caddy, interné 8504 Node) ---
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8504
WEB_HOST=127.0.0.1
WEB_PORT=8502
PUBLIC_ORIGIN=https://VÁŠA_DOMENA.example.com

# --- Logy ---
LOG_LEVEL=info

# --- Signing secret pre session tokeny (HMAC-SHA256) ---
# Povinné v produkcii: minimálne 32 znakov, unikátne, nie "REPLACE_".
# Musí byť ZHODNÉ s CMEP_STREAMING_SIGNING_SECRET na CMEP platforme (waste-platform).
SESSION_SIGNING_SECRET=VÁŠ_32_ZNAKOV_TAJNÝ_KLÚČ

# --- Mediasoup RTC porty (verejné UDP+TCP na VPS) ---
RTC_MIN_PORT=60000
RTC_MAX_PORT=60100

# --- Verejná IP VPS (pre ICE kandidáty) ---
ANNOUNCED_IP=VÁŠA_VPS_PUBLIC_IPV4

# --- Recorder (vypnuté defaultne; povoliť len s consensom a retenčnou politikou) ---
ENABLE_RECORDER=0
FFMPEG_PATH=ffmpeg
RTMP_URL=
REC_VIDEO_MS_PORT=7120
REC_VIDEO_MS_RTCP_PORT=7121
REC_VIDEO_FF_PORT=7130
REC_VIDEO_FF_RTCP_PORT=7131
REC_AUDIO_MS_PORT=7122
REC_AUDIO_MS_RTCP_PORT=7123
REC_AUDIO_FF_PORT=7132
REC_AUDIO_FF_RTCP_PORT=7133

# --- TURN server (coturn) — pre WebRTC relay za NAT (TURN REST API) ---
# TURN_SECRET: zdieľaný secret pre coturn (use-auth-secret + static-auth-secret).
# Coturn NEČÍTA tento .env priamo — deploy script vygeneruje /etc/turnserver.conf (600).
# TURN_REALM: realm pre TURN REST autentifikáciu.
TURN_SECRET=VÁŠ_32_ZNAKOV_TURN_TAJNÝ_KLÚČ
TURN_REALM=cmep-streaming
# Verejné TURN/STUN URL adresy vydávané klientom (server-side, krátkodobé credentials)
TURN_URLS=turn:VÁŠA_VPS_PUBLIC_IPV4:3478?transport=udp,turn:VÁŠA_VPS_PUBLIC_IPV4:3478?transport=tcp,turns:VÁŠA_VPS_PUBLIC_IPV4:5349?transport=tcp
TURN_STUN_URLS=stun:VÁŠA_VPS_PUBLIC_IPV4:3478
TURN_CREDENTIAL_TTL_SECONDS=600

# --- CMEP HTTP adaptér (integracia s waste-platform na Renderi) ---
CMEP_ADAPTER=http
# Base URL CMEP platformy (FastAPI) — pre verify/events volania
CMEP_PLATFORM_URL=https://VÁŠA_CMEP_PLATFORMA.example.com
# Interný kľúč pre X-CMEP-Internal-Key — musí byť zhodný s CMEP_INTERNAL_API_KEY na platforme
CMEP_INTERNAL_API_KEY=VÁŠ_32_ZNAKOV_INTERNÝ_KLÚČ
# Overenie na platforme pred každou akciou (fail-closed). V produkcii vždy 1.
CMEP_HTTP_VERIFY=1
CMEP_HTTP_TIMEOUT_MS=4000

# --- Limity ---
MAX_ROOMS=10
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_MS=5000
